+server {
+    listen 80;
+    server_name _;
+    root /usr/share/nginx/html;
+    index index.html;
+    location = /api/replay/control {
+        proxy_pass http://backend:8000/replay/control;
+        proxy_set_header Host $host;
+        proxy_read_timeout 60s;
+        limit_except POST { deny all; }
+    }
+    client_max_body_size 5m;
+    location ~ ^/api/(external/events/import|network/routes/import|network/map-match|analysis/what-if)$ {
+        rewrite ^/api/(.*)$ /$1 break;
+        proxy_pass http://backend:8000;
+        proxy_set_header Host $host;
+        limit_except POST { deny all; }
+    }
+    location /api/ {
+        proxy_pass http://backend:8000/;
+        proxy_set_header Host $host;
+        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+        proxy_read_timeout 60s;
+        # Dashboard and public proxy are read-only; ingest uses the internal API.
+        limit_except GET { deny all; }
+    }
+    location /docs { proxy_pass http://backend:8000; }
+    location /openapi.json { proxy_pass http://backend:8000; }
+    location / { try_files $uri $uri/ /index.html; }
