# Google Maps browser key: restrict to Maps JavaScript API and your website URLs.
VITE_GOOGLE_MAPS_API_KEY=
INGEST_TOKEN=

# Optional external context. Does not change model predictions.
VITE_YANDEX_MAPS_API_KEY=
WEATHER_ENABLED=true
CODD_FEED_URL=
CODD_API_TOKEN=
# Confirm the telemetry clock before enabling context alignment.
TELEMETRY_TIMEZONE=
# Incoming service settings are preserved. Leave disabled for historical replay.
NDTP_ENABLED=0
DETECT_STOPS=0
NDTP_HOST=127.0.0.1
NDTP_PORT=9201
NDTP_TIMEZONE=UTC
NDTP_UNIT_MAP={}
